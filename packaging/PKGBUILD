pkgname=keyra-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Premium low-latency typing sound engine and UI"
arch=('x86_64')
url="https://github.com/hikari/keyra" # Atualize com a URL real do projeto futuramente
license=('GPL3')
depends=('gtk3' 'alsa-lib' 'glibc' 'gcc-libs')
makedepends=('rust' 'cargo')
provides=('keyra')
conflicts=('keyra')
# Para compilação e empacotamento local, o PKGBUILD acessa a pasta do workspace diretamente.
# Quando for publicado no AUR, use: source=("git+https://github.com/hikari/keyra.git")
source=()
md5sums=()

build() {
  cd "$startdir/../keyra-daemon"
  export CARGO_HOME="$srcdir/cargo-home"

  # Limpar flags do makepkg que interferem no compilador de dependências C do Rust (como zstd-sys)
  unset CFLAGS
  unset CXXFLAGS
  unset LDFLAGS
  unset RUSTFLAGS

  cargo build --release

  cd "$startdir/../keyra-flutter"
  unset CFLAGS
  unset CXXFLAGS
  unset LDFLAGS
  unset RUSTFLAGS
  flutter build linux --release
}

package() {
  # 1. Instalar o Daemon
  install -Dm755 "$startdir/../keyra-daemon/target/release/keyra-daemon" "$pkgdir/usr/bin/keyra-daemon"

  # 2. Instalar a UI (Flutter bundle) no /opt/keyra
  mkdir -p "$pkgdir/opt/keyra"
  cp -r "$startdir/../keyra-flutter/build/linux/x64/release/bundle/"* "$pkgdir/opt/keyra/"
  
  # Dar permissão de execução ao binário do Flutter
  chmod +x "$pkgdir/opt/keyra/keyra_app"

  # Criar link simbólico para a UI no /usr/bin
  mkdir -p "$pkgdir/usr/bin"
  ln -sf "/opt/keyra/keyra_app" "$pkgdir/usr/bin/keyra"

  # 3. Instalar o arquivo .desktop para aparecer no menu de aplicativos
  install -Dm644 "$startdir/io.github.hikarilucky79.keyra.desktop" "$pkgdir/usr/share/applications/io.github.hikarilucky79.keyra.desktop"

  # 4. Instalar o serviço systemd do usuário
  install -Dm644 "$startdir/keyra.service" "$pkgdir/usr/lib/systemd/user/keyra.service"

  # 5. Instalar o ícone do aplicativo
  install -Dm644 "$startdir/../keyra-flutter/assets/icons/tray_icon.png" "$pkgdir/usr/share/pixmaps/io.github.hikarilucky79.keyra.png"
}
